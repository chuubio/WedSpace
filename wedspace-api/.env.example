PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wedspace
DB_USER=root
DB_PASS=

JWT_SECRET=isi_dengan_secret_acak_lokal

# --- Konfigurasi Gemini AI (Rekomendasi Dekorasi) ---
# Isi dengan API key dari Google AI Studio (https://aistudio.google.com).
GEMINI_API_KEY=
# Model Gemini yang digunakan (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Konfigurasi paket langganan (Subscription) ---
# Semua nilai ini juga punya default di src/config/subscription.js.
# Kosongkan PREMIUM_MAX_ACTIVE_PROJECTS bila ingin Premium tanpa batas proyek.
FREE_MAX_ACTIVE_PROJECTS=2
FREE_AI_RECOMMENDATIONS_PER_WEEK=3
PREMIUM_AI_RECOMMENDATIONS_PER_WEEK=30
PREMIUM_MAX_ACTIVE_PROJECTS=
# Durasi paket Premium pada simulasi upgrade lokal (hari)
PREMIUM_DURATION_DAYS=30

# Set ke production untuk mematikan endpoint simulasi
# POST /api/subscription/activate dan /reset
# NODE_ENV=production
